<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smile Electronic Store</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #111827;
    }

    header {
      background: #111827;
      color: white;
      padding: 18px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 22px;
      font-weight: bold;
    }

    .whatsapp {
      background: #25D366;
      color: white;
      text-decoration: none;
      padding: 10px 16px;
      border-radius: 25px;
      font-weight: bold;
    }

    .hero {
      padding: 70px 7%;
      background: linear-gradient(135deg, #111827, #2563eb);
      color: white;
    }

    .hero h1 {
      font-size: 45px;
      margin-bottom: 15px;
    }

    .hero p {
      font-size: 18px;
      max-width: 600px;
      line-height: 1.6;
    }

    .button {
      display: inline-block;
      margin-top: 20px;
      padding: 14px 22px;
      background: #25D366;
      color: white;
      text-decoration: none;
      border-radius: 8px;
      font-weight: bold;
    }

    section {
      padding: 50px 7%;
    }

    .title {
      text-align: center;
      margin-bottom: 30px;
      font-size: 30px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
    }

    .card {
      background: white;
      padding: 25px;
      border-radius: 15px;
      text-align: center;
      box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    }

    .phone {
      font-size: 70px;
      margin-bottom: 15px;
    }

    .price {
      font-size: 21px;
      font-weight: bold;
      margin: 15px 0;
    }

    .card .button {
      background: #111827;
    }

    .about {
      text-align: center;
      max-width: 700px;
      margin: auto;
      line-height: 1.7;
      font-size: 17px;
    }

    .contact {
      background: #111827;
      color: white;
      text-align: center;
    }

    footer {
      background: #080d18;
      color: #ccc;
      text-align: center;
      padding: 20px;
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">😊 Smile Electronic Store</div>

    <a class="whatsapp"
       href="https://wa.me/237651316548">
       WhatsApp
    </a>
  </header>

  <div class="hero">
    <h1>Smile Electronic Store</h1>

    <p>
      Welcome to Smile Electronic Store in Buea, Cameroon.
      Find quality smartphones at competitive prices.
    </p>

    <a class="button"
       href="https://wa.me/237651316548?text=Hello%20Smile%20Electronic%20Store%2C%20I%20want%20to%20make%20an%20inquiry.">
       Chat With Us
    </a>
  </div>

  <section>
    <h2 class="title">Our Phones</h2>

    <div class="products">

      <div class="card">
        <div class="phone">📱</div>

        <h3>iPhone 17</h3>

        <div class="price">
          550,000 – 600,000 FCFA
        </div>

        <p>Contact us for availability.</p>

        <a class="button"
           href="https://wa.me/237651316548?text=Hello%2C%20I%20am%20interested%20in%20the%20iPhone%2017.">
           Order on WhatsApp
        </a>
      </div>


      <div class="card">
        <div class="phone">📱</div>

        <h3>iPhone 11</h3>

        <div class="price">
          150,000 – 200,000 FCFA
        </div>

        <p>Contact us for availability.</p>

        <a class="button"
           href="https://wa.me/237651316548?text=Hello%2C%20I%20am%20interested%20in%20the%20iPhone%2011.">
           Order on WhatsApp
        </a>
      </div>

    </div>
  </section>

  <section>
    <h2 class="title">About Us</h2>

    <div class="about">
      <p>
        Smile Electronic Store is a local electronics business
        located in Buea, Cameroon. We sell smartphones and help
        customers find phones that suit their needs.
      </p>
    </div>
  </section>

  <section class="contact">
    <h2>Contact Smile Electronic Store</h2>

    <p style="margin-top:15px;">📍 Buea, Cameroon</p>

    <p style="margin-top:10px;">
      📞 +237 651 316 548
    </p>

    <a class="button"
       href="https://wa.me/237651316548?text=Hello%20Smile%20Electronic%20Store%2C%20I%20would%20like%20to%20know%20more%20about%20your%20phones.">
       Message Us on WhatsApp
    </a>
  </section>

  <footer>
    © 2026 Smile Electronic Store — Buea, Cameroon
  </footer>

</body>
</html>
